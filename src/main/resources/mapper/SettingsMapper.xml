<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC '-//mybatis.org//DTD Mapper 3.0//EN'
  'https://mybatis.org/dtd/mybatis-3-mapper.dtd'>
<mapper namespace="com.company.safetylaw.mapper.SettingsMapper">
    <resultMap id="row" type="com.company.safetylaw.domain.AppSetting">
        <id column="setting_key" property="settingKey" javaType="java.lang.String"/>
        <result column="setting_value" property="settingValue" javaType="java.lang.String" jdbcType="CLOB" typeHandler="org.apache.ibatis.type.ClobTypeHandler"/>
    </resultMap>
    <sql id="columns">setting_key, setting_value</sql>
    <select id="selectById" resultMap="row">
        SELECT
        <include refid="columns"/>
        FROM slm_setting WHERE setting_key = #{id}
    </select>
    <select id="selectAll" resultMap="row">
        SELECT
        <include refid="columns"/>
        FROM slm_setting ORDER BY setting_key
    </select>
    <insert id="insert">INSERT INTO slm_setting (setting_key, setting_value) VALUES (#{settingKey,jdbcType=VARCHAR}, #{settingValue,jdbcType=CLOB})</insert>
    <update id="update">UPDATE slm_setting SET setting_value = #{settingValue,jdbcType=CLOB} WHERE setting_key = #{settingKey,jdbcType=VARCHAR}</update>
    <delete id="deleteById">DELETE FROM slm_setting WHERE setting_key = #{id}</delete>
</mapper>
